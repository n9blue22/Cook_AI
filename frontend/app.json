{
  "expo": {
    "name": "Chef AI",
    "slug": "chef-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Chef AI",
      "shortName": "Chef AI",
      "themeColor": "#2E6B4A",
      "backgroundColor": "#FBF8F2",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Chef AI cần camera để nhận diện nguyên liệu."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Chef AI cần truy cập ảnh để nhận diện nguyên liệu."
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "chefai",
    "backgroundColor": "#FBF8F2",
    "experiments": {
      "typedRoutes": true
    }
  }
}
