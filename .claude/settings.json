{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/strip_commit_attribution.py\"",
            "timeout": 30,
            "statusMessage": "Kiểm tra attribution trong commit"
          }
        ]
      }
    ]
  }
}
