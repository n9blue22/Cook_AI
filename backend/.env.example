# Copy file này thành backend/.env rồi điền giá trị thật. Không commit .env.

# development | production
ENV=development

# Supabase: Dashboard → Project Settings → API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Bỏ qua RLS: scripts/seed_*.py và backend ghi Supabase Storage (ảnh AI). CHỈ nằm trên server —
# tuyệt đối không đưa vào frontend / app client. Supabase: Dashboard → Project Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=sb_secret_xxx

# USDA FoodData Central: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=xxx

# Google AI Studio: https://aistudio.google.com/apikey — dùng cho vision (services/vision/gemini.py)
GEMINI_API_KEY=xxx

# Groq: https://console.groq.com/keys — dùng cho LLM chỉnh công thức (services/llm/groq_adapter.py)
GROQ_API_KEY=xxx

# Cloudflare Workers AI (ảnh minh hoạ món, FLUX-1-schnell — services/image_gen/cloudflare_flux.py)
# Dashboard → Manage Account → Account API Tokens; token cần quyền "Workers AI" (Read + Edit)
CF_ACCOUNT_ID=xxx
CF_API_TOKEN=xxx

# Frontend được phép gọi API (CORS, có cookie) — nhiều domain cách nhau dấu phẩy. Không dùng "*".
CORS_ORIGINS=http://localhost:8081
# Link trong email xác minh / đặt lại mật khẩu trỏ về đây. Phải thêm vào Supabase → Auth → URL Configuration.
FRONTEND_URL=http://localhost:8081

# Trần tổng mỗi ngày (toàn app, giờ VN) cho endpoint tốn quota AI — xem services/rate_limit.py.
RECOGNIZE_DAILY_CAP=200
SUGGEST_DAILY_CAP=15
IMAGE_DAILY_CAP=50
# Số món đầu danh sách cho LLM chỉnh mỗi lượt /recipes/suggest, các món sau trả bản gốc (services/pipeline.py).
# Groq free tier 8000 token/phút/model, 1 lời gọi ~5k token → để 1; tăng lên là 429 ngay trong 1 lượt.
SUGGEST_LLM_ADAPT_COUNT=1
# Nâng trần tạm thời (ngày demo): đặt *_DAILY_CAP_OVERRIDE + ngày hết hạn; qua ngày đó tự về trần thường.
# SUGGEST_DAILY_CAP_OVERRIDE=60
# DAILY_CAP_OVERRIDE_UNTIL=2026-10-05
