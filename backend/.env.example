# Copy file này thành backend/.env rồi điền giá trị thật. Không commit .env.

# development | production
ENV=development

# Supabase: Dashboard → Project Settings → API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Chỉ dùng cho scripts/seed_*.py (ghi bảng danh mục, bỏ qua RLS). KHÔNG đưa vào app/frontend.
# Supabase: Dashboard → Project Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=sb_secret_xxx

# USDA FoodData Central: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=xxx
